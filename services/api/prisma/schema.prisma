// ------------------------- Timesheets & Leave -------------------------

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TimesheetEntry {
  id             String          @id @default(uuid())
  organizationId String
  userId         String
  workDate       DateTime
  projectId      String?
  taskId         String?
  hours          Float           @default(8)
  activity       String? // description of work performed
  status         TimesheetStatus @default(DRAFT)
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("TimesheetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, workDate])
  @@index([organizationId, workDate])
  @@index([userId, workDate])
}

model LeaveType {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  code             String
  color            String   @default("#6366f1")
  isPaid           Boolean  @default(true)
  daysPerYear      Float    @default(25)
  carryOverDays    Float    @default(0)
  accrualPerMonth  Float? // if set, monthly accrual instead of yearly lump sum
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model LeaveBalance {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  typeId         String
  year           Int
  granted        Float    @default(0)
  used           Float    @default(0)
  pending        Float    @default(0)
  carriedOver    Float    @default(0)
  adjusted       Float    @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, typeId, year])
  @@index([organizationId, userId])
}

model LeaveRequest {
  id             String             @id @default(uuid())
  organizationId String
  userId         String
  typeId         String
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, startDate])
}

/**
 * Days the company actually closes. Selected from the public-holiday feed by
 * managers on the Holidays page; surfaced as "OFF" in the user timesheet.
 */
model CompanyOffDay {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime // UTC midnight of the off day
  name           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

// ------------------------- Payroll -------------------------

enum PayrollRunStatus {
  PENDING
  PAID
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  month          String // "YYYY-MM"
  currency       String           @default("MAD")
  status         PayrollRunStatus @default(PENDING)
  grossTotal     Float            @default(0)
  netTotal       Float            @default(0)
  entries        Json             @default("[]") // [{ memberId, memberName, hours, regularHours, overtimeHours, gross, bonus, net }]
  createdById    String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, month])
  @@index([organizationId, status])
