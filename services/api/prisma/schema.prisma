// TechVerse Platform - Prisma schema (PostgreSQL)
// Multi-tenant: every tenant-scoped table carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- Enums -------------------------

enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectType {
  GENERAL
  ENGINEERING
  MARKETING
  SALES
  HR
  OTHER
}

enum ProjectVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum TaskType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ScanStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

// ------------------------- Users & Org -------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String?
  avatarUrl    String?
  locale       String     @default("ar")
  timezone     String     @default("Africa/Tunis")
  role         String     @default("user")
  status       String     @default("ACTIVE")
  statusNote   String?
  statusUntil  DateTime?
  lastSeenAt   DateTime?
  gitTokens    GitToken[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships              OrganizationMember[]
  teamMembers              TeamMember[]
  ownedProjects            Project[]            @relation("ProjectOwner")
  tasks                    Task[]               @relation("TaskAssignee")
  reportedTasks            Task[]               @relation("TaskReporter")
  comments                 Comment[]
  conversations            ConversationMember[]
  messages                 Message[]
  reactions                Reaction[]
  invitesSent              Invite[]             @relation("InviteInviter")
  notifications            Notification[]
  auditLogs                AuditLog[]
  devIssues                DevIssue[]
  files                    FileAttachment[]
  pipelines                Pipeline[]           @relation("PipelineCreator")
  pipelineRuns             PipelineRun[]        @relation("PipelineRunCreator")
  aiProviders              AiProvider[]         @relation("AiProviderCreator")
  aiActionRuns             AiActionRun[]        @relation("AiActionRunCreator")
  agentConnections         AgentConnection[]    @relation("AgentConnectionCreator")
  agentRuns                AgentRun[]           @relation("AgentRunCreator")
  timesheetEntries         TimesheetEntry[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  reviewedTimesheets       TimesheetEntry[]     @relation("TimesheetReviewer")
  reviewedLeaves           LeaveRequest[]       @relation("LeaveReviewer")
  payrollRuns              PayrollRun[]         @relation("PayrollRunCreator")
  serviceItemsCreated      ServiceItem[]        @relation("ServiceItemCreator")
  serviceRequestsRequested ServiceRequest[]     @relation("ServiceRequestRequester")
  serviceRequestsAssigned  ServiceRequest[]     @relation("ServiceRequestAssignee")
  serviceRequestsApproved  ServiceRequest[]     @relation("ServiceRequestApprover")
  incidentsRequested       Incident[]           @relation("IncidentRequester")
  incidentsAssigned        Incident[]           @relation("IncidentAssignee")
  articlesAuthored         KnowledgeArticle[]   @relation("ArticleAuthor")
  serviceComments          ServiceComment[]     @relation("ServiceCommentAuthor")
  refreshTokens            RefreshToken[]
  sprintPlans              SprintPlan[]         @relation("SprintPlanCreator")
  factoryApprovals         FactoryApproval[]    @relation("FactoryApprovalDecider")
}

/// Rotating refresh tokens (one row per issued jti). Revoking a row invalidates
/// the token; a revoked/rotated token showing up again is treated as theft and
/// revokes the whole family (all of the user's active tokens).
model RefreshToken {
  id           String    @id // jti embedded in the refresh JWT
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  plan           String    @default("free")
  billingEmail   String?
  country        String?
  currency       String    @default("TND")
  locale         String    @default("ar")
  timezone       String    @default("Africa/Tunis")
  workWeekStart  Int       @default(1)
  holidayCountry String?
  holidayRegion  String?
  trialEnd       DateTime?
  status         String    @default("active")
  subscriptionId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  members              OrganizationMember[]
  departments          Department[]
  teams                Team[]
  projects             Project[]
  tasks                Task[]
  workflows            Workflow[]
  sprints              Sprint[]
  comments             Comment[]
  conversations        Conversation[]
  messages             Message[]
  invites              Invite[]
  calendarEvents       CalendarEvent[]
  files                FileAttachment[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  billing              Billing?
  repositories         DevRepository[]
  scans                DevScan[]
  issues               DevIssue[]
  analysisConfigs      DevAnalysisConfig[]
  gitRepositories      GitRepository[]
  gitTokens            GitToken[]
  pipelines            Pipeline[]
  pipelineRuns         PipelineRun[]
  aiProviders          AiProvider[]
  aiActionRuns         AiActionRun[]
  agentConnections     AgentConnection[]
  agentRuns            AgentRun[]
  sprintPlans          SprintPlan[]
  timesheetEntries     TimesheetEntry[]
  leaveTypes           LeaveType[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  companyOffDays       CompanyOffDay[]
  serverConnections    ServerConnection[]
  deployedApps         DeployedApp[]
  payrollRuns          PayrollRun[]
  serviceItems         ServiceItem[]
  serviceRequests      ServiceRequest[]
  incidents            Incident[]
  knowledgeArticles    KnowledgeArticle[]
  serviceComments      ServiceComment[]
  slaPolicies          ServiceSlaPolicy[]
  agentProfiles        AgentProfile[]
  factoryIssueProfiles FactoryIssueProfile[]
  factoryRuns          FactoryRun[]
  factoryPlans         FactoryPlan[]
  factoryEvents        FactoryEvent[]
  factoryApprovals     FactoryApproval[]
  factoryQualityGates  FactoryQualityGate[]
  factoryPullRequests  FactoryPullRequest[]
  policyRules          PolicyRule[]
  policyRuleVersions   PolicyRuleVersion[]
  policyEvaluations    PolicyEvaluation[]
  automationProposals  AutomationProposal[]

  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBER)
  title          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

// ------------------------- Teams -------------------------

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@index([organizationId])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  departmentId   String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  projects     ProjectTeam[]
  sprints      Sprint[]

  @@index([organizationId])
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  role   String @default("member")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ------------------------- Projects -------------------------

model Project {
  id             String            @id @default(uuid())
  organizationId String
  ownerId        String
  name           String
  description    String?
  key            String?
  type           ProjectType       @default(GENERAL)
  visibility     ProjectVisibility @default(PRIVATE)
  status         String            @default("active")
  startDate      DateTime?
  dueDate        DateTime?
  color          String            @default("#2563eb")
  repoUrl        String?
  settings       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User                @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teams            ProjectTeam[]
  workflows        Workflow[]
  sprints          Sprint[]
  tasks            Task[]
  repositories     DevRepository[]
  devScans         DevScan[]
  analysisConfigs  DevAnalysisConfig[]
  gitRepositories  GitRepository[]
  timesheetEntries TimesheetEntry[]
  factoryRuns      FactoryRun[]

  @@index([organizationId])
  @@index([ownerId])
}

model ProjectTeam {
  id        String @id @default(uuid())
  projectId String
  teamId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
}

// ------------------------- Boards & Tasks -------------------------

model Workflow {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  name           String   @default("Board")
  method         String   @default("kanban")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns      WorkflowColumn[]

  @@unique([projectId, name])
  @@index([organizationId])
}

model WorkflowColumn {
  id         String  @id @default(uuid())
  workflowId String
  name       String
  status     String
  color      String? @default("#2563eb")
  wipLimit   Int?
  isBacklog  Boolean @default(false)
  position   Int     @default(0)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([workflowId, name])
  @@index([workflowId])
}

model Sprint {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  teamId         String?
  name           String
  goal           String?
  startDate      DateTime?
  endDate        DateTime?
  status         SprintStatus @default(PLANNING)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([organizationId, projectId])
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  sprintId       String?
  columnId       String?
  epicId         String?
  parentId       String?
  assigneeId     String?
  reporterId     String?
  devIssueId     String?
  title          String
  description    String?
  type           TaskType     @default(TASK)
  status         String       @default("TODO")
  priority       TaskPriority @default(MEDIUM)
  storyPoints    Int?
  order          Int          @default(0)
  dueDate        DateTime?
  estimateHours  Float?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint              Sprint?              @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  column              WorkflowColumn?      @relation(fields: [columnId], references: [id], onDelete: SetNull)
  epic                Task?                @relation("TaskEpic", fields: [epicId], references: [id], onDelete: SetNull)
  epics               Task[]               @relation("TaskEpic")
  parent              Task?                @relation("Subtask", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks            Task[]               @relation("Subtask")
  assignee            User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter            User?                @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  comments            Comment[]
  files               FileAttachment[]
  devIssue            DevIssue?            @relation(fields: [devIssueId], references: [id], onDelete: SetNull)
  timesheetEntries    TimesheetEntry[]
  factoryRuns         FactoryRun[]
  factoryIssueProfile FactoryIssueProfile?

  @@index([organizationId, projectId, status])
  @@index([assigneeId])
}

model Comment {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  authorId       String
  body           String
  mentions       Json     @default("[]")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId])
}

// ------------------------- Chat -------------------------

model Conversation {
  id             String           @id @default(uuid())
  organizationId String
  name           String?
  type           ConversationType @default(GROUP)
  createdBy      String?
  lastMessageAt  DateTime?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ConversationMember[]
  messages     Message[]

  @@index([organizationId])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  role           String    @default("MEMBER")
  lastReadAt     DateTime?
  unreadCount    Int       @default(0)
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(uuid())
  organizationId String
  conversationId String
  senderId       String
  kind           String    @default("TEXT")
  body           String
  mediaUrl       String?
  mediaWidth     Int?
  mediaHeight    Int?
  mimeType       String?
  replyToId      String?
  deletedAt      DateTime?
  mentionIds     String[]  @default([])
  editedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?        @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]       @relation("MessageReply")
  attachment   FileAttachment?
  reactions    Reaction[]

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@index([replyToId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// ------------------------- Calendar -------------------------

model CalendarEvent {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  allDay         Boolean   @default(false)
  location       String?
  type           String    @default("OTHER")
  projectId      String?
  creatorId      String
  attendees      Json      @default("[]")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
}

// ------------------------- Files -------------------------

model FileAttachment {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  mimeType       String
  size           Int
  storageKey     String
  taskId         String?
  messageId      String?  @unique
  uploadedById   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invite {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole   @default(MEMBER)
  title          String?
  token          String    @unique
  invitedById    String
  status         String    @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([token])
}

// ------------------------- Notifications -------------------------

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  COMMENT
  MENTION
  PROJECT_UPDATE
  MEETING
  SCAN_COMPLETED
  INVITE
  SYSTEM
  PIPELINE_COMPLETED
  PIPELINE_FAILED
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

// ------------------------- Audit -------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ------------------------- Billing -------------------------

model Billing {
  id               String    @id @default(uuid())
  organizationId   String    @unique
  plan             String    @default("free")
  status           String    @default("active")
  seats            Int       @default(1)
  usageThisPeriod  Float     @default(0)
  usageLimit       Float?
  currentPeriodEnd DateTime?
  subscriptionId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ------------------------- Development / TechDebt -------------------------

model DevRepository {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  fullPath       String?
  url            String?
  provider       String    @default("other")
  defaultBranch  String    @default("main")
  language       String?
  sizeKb         Int       @default(0)
  techDebtRatio  Float?
  token          String?
  webhookSecret  String?
  scanOnPush     Boolean   @default(false)
  lastSyncAt     DateTime?
  lastCommitSha  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scans        DevScan[]

  @@index([organizationId])
  @@index([projectId])
}

model DevScan {
  id             String     @id @default(uuid())
  organizationId String
  projectId      String?
  repositoryId   String?
  status         ScanStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  filesScanned   Int?
  linesAnalyzed  Int?
  metrics        Json       @default("{}")
  error          String?
  createdAt      DateTime   @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository   DevRepository?       @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  issues       DevIssue[]
  factoryGates FactoryQualityGate[]

  @@index([organizationId])
  @@index([status])
}

model DevIssue {
  id             String    @id @default(uuid())
  organizationId String
  scanId         String
  filePath       String
  lineNumber     Int?
  columnStart    Int?
  columnEnd      Int?
  codeSnippet    String?
  fix            Json?
  message        String
  severity       Severity  @default(MEDIUM)
  category       String?
  ruleId         String?
  suggestion     String?
  fingerprint    String?
  isFixed        Boolean   @default(false)
  fixedAt        DateTime?
  assigneeId     String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan         DevScan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@index([organizationId, severity])
  @@index([scanId])
}

model DevAnalysisConfig {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  config         Json?    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId])
  @@index([organizationId])
}

// ------------------------- Hosted Git -------------------------

model GitRepository {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  description    String?
  visibility     String    @default("private")
  storagePath    String
  defaultBranch  String    @default("main")
  sizeKb         Int       @default(0)
  fileCount      Int       @default(0)
  lastCommitSha  String?
  lastPushAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pipelines           Pipeline[]
  factoryRuns         FactoryRun[]
  factoryPullRequests FactoryPullRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model GitToken {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  name           String
  tokenHash      String
  prefix         String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tokenHash])
}

// ------------------------- CI/CD Pipelines -------------------------

enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model Pipeline {
  id             String   @id @default(uuid())
  organizationId String
  repositoryId   String
  name           String
  description    String?
  trigger        String   @default("manual") // manual | push
  branch         String   @default("main")
  status         String   @default("active") // active | disabled
  steps          Json     @default("[]") // [{ id, name, command }]
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("PipelineCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs         PipelineRun[]

  @@index([organizationId])
  @@index([repositoryId])
}

model PipelineRun {
  id             String    @id @default(uuid())
  organizationId String
  pipelineId     String
  status         RunStatus @default(QUEUED)
  trigger        String    @default("manual") // manual | push
  branch         String    @default("main")
  commitSha      String?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  steps          Json      @default("[]") // [{ id, name, command, status, startedAt, completedAt, durationMs, output }]
  error          String?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PipelineRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([pipelineId, createdAt])
  @@index([status])
}

model AiProvider {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  type            String // openai | anthropic | google | groq | mistral | openrouter | azure | ollama | openai_compatible
  baseUrl         String?
  apiKeyEncrypted String? // AES-256-GCM ciphertext (iv.tag.cipher base64)
  apiKeyHint      String? // last 4 chars of the key, for display
  models          Json      @default("[]") // string[]  (auto-fetched + manual overrides)
  defaultModel    String?
  status          String    @default("active") // active | disabled
  lastTestAt      DateTime?
  lastTestStatus  String? // ok | fail
  lastTestError   String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("AiProviderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agentProfiles AgentProfile[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model AgentConnection {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  baseUrl         String
  agentId         String
  apiKeyEncrypted String? // AES-256-GCM ciphertext (iv.tag.cipher base64)
  apiKeyHint      String? // last 4 chars of the key, for display
  status          String    @default("active") // active | disabled
  lastTestAt      DateTime?
  lastTestStatus  String? // ok | fail
  lastTestError   String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("AgentConnectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs          AgentRun[]
  factoryRuns   FactoryRun[]
  agentProfiles AgentProfile[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model AgentRun {
  id             String   @id @default(uuid())
  organizationId String
  connectionId   String
  status         String   @default("completed") // completed | failed
  input          Json
  output         Json?
  error          String?
  durationMs     Int?
  providerRunId  String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   AgentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("AgentRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
}

model AiActionRun {
  id             String    @id @default(uuid())
  organizationId String
  providerId     String?
  providerName   String?
  model          String?
  action         String // optimize_dockerfile | optimize_pipeline | fix_scan_issues | explain_code
  status         String    @default("completed") // completed | failed
  input          Json // action-specific input
  output         Json? // action-specific result (suggestions / diffs)
  applied        Boolean   @default(false)
  appliedAt      DateTime?
  error          String?
  durationMs     Int?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AiActionRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([action])
}

// ------------------------- Sprint planner (cahier de charge → tickets) ----

model SprintPlan {
