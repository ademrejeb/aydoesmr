// ------------------------- Service Desk (ITSM) -------------------------

enum ServicePriority {
  P1
  P2
  P3
  P4
}

enum ServiceRequestStatus {
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  FULFILLED
  CANCELLED
  CLOSED
}

enum IncidentStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ServiceEntityType {
  REQUEST
  INCIDENT
  ARTICLE
}

/// A bookable service in the self-service catalog. `formSchema` drives the
/// dynamic request form rendered by the web app:
/// [{ key, label, type: text|textarea|number|date|select|checkbox, required, options? }]
model ServiceItem {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  description      String
  category         String // IT | ACCESS | FACILITIES | HR | FINANCE
  icon             String? // lucide icon name
  active           Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  estimatedDays    Int?
  sortOrder        Int      @default(0)
  formSchema       Json     @default("[]")
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("ServiceItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  requests     ServiceRequest[]

  @@index([organizationId, active])
  @@index([organizationId, category])
}

model ServiceRequest {
  id             String               @id @default(uuid())
  organizationId String
  number         String // REQ-000001
  itemId         String?
  title          String
  description    String
  status         ServiceRequestStatus @default(SUBMITTED)
  priority       ServicePriority      @default(P3)
  formData       Json                 @default("{}")
  requesterId    String?
  requesterEmail String?
  requesterName  String?
  assigneeId     String?
  approverId     String?
  decisionNote   String?
  rating         Int? // 1..5 satisfaction after fulfilment
  submittedAt    DateTime             @default(now())
  approvedAt     DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  targetAt       DateTime? // estimated fulfilment date
  dueAt          DateTime? // SLA target date
  source         String               @default("portal") // portal | app
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  item         ServiceItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  requester    User?        @relation("ServiceRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approver     User?        @relation("ServiceRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  incidents    Incident[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([assigneeId])
  @@index([requesterId])
}

model Incident {
  id               String          @id @default(uuid())
  organizationId   String
  number           String // INC-000001
  title            String
  description      String
  status           IncidentStatus  @default(NEW)
  priority         ServicePriority @default(P3)
  category         String?
  assigneeId       String?
  requesterId      String?
  requesterEmail   String?
  requesterName    String?
  linkedRequestId  String?
  resolution       String?
  rootCause        String?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  responseDueAt    DateTime?
  resolveDueAt     DateTime?
  responseBreached Boolean         @default(false)
  resolveBreached  Boolean         @default(false)
  reopenCount      Int             @default(0)
  source           String          @default("portal")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee      User?           @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requester     User?           @relation("IncidentRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  linkedRequest ServiceRequest? @relation(fields: [linkedRequestId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([assigneeId])
}

model KnowledgeArticle {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  slug           String
  summary        String?
  body           String
  category       String   @default("GENERAL")
  tags           Json     @default("[]")
  views          Int      @default(0)
  helpful        Int      @default(0)
  notHelpful     Int      @default(0)
  published      Boolean  @default(true)
  incidentId     String?
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug])
  @@index([organizationId, category])
}

model ServiceComment {
  id             String            @id @default(uuid())
  organizationId String
  entityType     ServiceEntityType
  entityId       String
  authorId       String?
  authorName     String?
  body           String
  internal       Boolean           @default(false)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("ServiceCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([entityType, entityId])
}

/// Per-priority SLA targets. Missing rows fall back to built-in defaults.
model ServiceSlaPolicy {
  id                String          @id @default(uuid())
  organizationId    String
  priority          ServicePriority
  name              String
  responseMinutes   Int
  resolveMinutes    Int
  businessHoursOnly Boolean         @default(false)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, priority])
}

// ------------------------- Governance policies -------------------------
//
// Deterministic, organization-scoped rules evaluated at execution boundaries
// (factory dispatch, merge, agent runs, pipeline runs). Code-analysis rules
// stay in the Rust engine (`crates/td-rules`); these rules govern *actions*,
// not source patterns, so the two engines never overlap.

enum PolicyEffect {
  ALLOW
  DENY
  REQUIRE_APPROVAL
  WARN
}

model PolicyRule {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  repositoryId   String?
  key            String
  name           String
  description    String?
  category       String       @default("agent") // project | git | agent | quality | security | deployment
  effect         PolicyEffect
  priority       Int          @default(100)
  enabled        Boolean      @default(true)
  scope          String       @default("ORGANIZATION") // ORGANIZATION | PROJECT | REPOSITORY
  subject        String // action key: factory.execute, factory.merge, agent.run, pipeline.run...
  conditions     Json         @default("[]") // [{ key, op, value }]
  actions        Json         @default("{}") // { approvalRole, message, ... }
  version        Int          @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     PolicyRuleVersion[]

  @@unique([organizationId, key])
  @@index([organizationId, subject, enabled])
  @@index([organizationId, projectId])
}

model PolicyRuleVersion {
  id             String   @id @default(uuid())
  organizationId String
  ruleId         String
  version        Int
  snapshot       Json
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         PolicyRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([organizationId, createdAt])
}

model PolicyEvaluation {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  runId          String?
  subject        String
  action         String?
  decision       String // ALLOW | DENY | REQUIRE_APPROVAL | WARN
  allowed        Boolean
  reasons        Json     @default("[]")
  context        Json     @default("{}")
  ruleIds        Json     @default("[]")
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, subject, createdAt])
}

// ------------------------- Software factory -------------------------

enum FactoryRunStatus {
  QUEUED
  TRIAGED
  PLANNED
  WAITING_APPROVAL
  EXECUTING
  QUALITY_CHECK
  WAITING_REVIEW
  READY_TO_MERGE
  MERGED
  FAILED
  BLOCKED
  CANCELLED
}

enum FactoryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FactoryGateStatus {
  PENDING
  PASSED
  FAILED
  BLOCKED
}

/// Configurable specialist agent. A profile points at an existing published
/// agent connection (AI Agent Factory) and an optional model provider used for
/// planning/review tasks executed by the platform itself.
model AgentProfile {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  role            String // TRIAGE | ARCHITECT | PLANNER | FRONTEND | BACKEND | RUST | QA | REVIEWER | SECURITY | DEVOPS | DOCS
  description     String?
  instructions    String?
  connectionId    String?
  modelProviderId String?
  model           String?
  capabilities    Json     @default("[]")
  allowedTools    Json     @default("[]")
  permissions     Json     @default("{}")
  budgetTokens    Int      @default(20000)
  timeoutSeconds  Int      @default(120)
  maxRetries      Int      @default(1)
  version         Int      @default(1)
  status          String   @default("active") // active | disabled
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection    AgentConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  modelProvider AiProvider?      @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  runs          FactoryRun[]     @relation("FactoryRunAgent")

  @@unique([organizationId, slug])
  @@index([organizationId, role, status])
}

/// Explainable classification for a task/issue. One row per task; regenerating
/// overwrites it but keeps the run/event history.
model FactoryIssueProfile {
  id                        String   @id @default(uuid())
  organizationId            String
  taskId                    String   @unique
  classification            String // BUG | FEATURE | IMPROVEMENT | TECH_DEBT | SECURITY | INFRA | DOCS | RESEARCH | ARCHITECTURE
  labels                    String[] @default([])
  complexity                Int      @default(1)
  risk                      String   @default("low") // low | medium | high
  autonomous                Boolean  @default(false)
  confidence                Float    @default(0)
  missingAcceptanceCriteria Boolean  @default(false)
  duplicateOfIds            String[] @default([])
  suggestedPriority         String?
  suggestedAgentRole        String?
  rationale                 Json     @default("[]")
  analyzedBy                String   @default("heuristic") // heuristic | ai:<model>
  model                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, classification])
  @@index([organizationId, autonomous])
}

model FactoryRun {
  id             String           @id @default(uuid())
  organizationId String
  projectId      String
  taskId         String
  repositoryId   String?
  agentProfileId String?
  connectionId   String?
  status         FactoryRunStatus @default(QUEUED)
  stage          String           @default("TRIAGE")
  correlationId  String           @unique @default(uuid())
  idempotencyKey String           @default(uuid())
  branch         String?
  baseBranch     String?
  commitSha      String?
  planVersion    Int?
  error          String?
  metadata       Json             @default("{}")
  createdById    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository   GitRepository?       @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  agentProfile AgentProfile?        @relation("FactoryRunAgent", fields: [agentProfileId], references: [id], onDelete: SetNull)
  connection   AgentConnection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  plans        FactoryPlan[]
  events       FactoryEvent[]
  approvals    FactoryApproval[]
  gates        FactoryQualityGate[]
  pullRequest  FactoryPullRequest?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, taskId])
}

model FactoryPlan {
  id                 String   @id @default(uuid())
  organizationId     String
  runId              String
  version            Int      @default(1)
  status             String   @default("GENERATED") // GENERATED | ACCEPTED | SUPERSEDED
  summary            String
  steps              Json     @default("[]")
  files              Json     @default("[]")
  tests              Json     @default("[]")
  acceptanceCriteria Json     @default("[]")
  risks              Json     @default("[]")
  outOfScope         Json     @default("[]")
  approvalRequired   Boolean  @default(true)
  generatedBy        String   @default("heuristic") // heuristic | ai:<model>
  model              String?
  reasoning          String?
  createdById        String?
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FactoryRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, version])
  @@index([organizationId, createdAt])
}

model FactoryEvent {
  id             String   @id @default(uuid())
  organizationId String
  runId          String
  type           String
  actorId        String?
  correlationId  String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FactoryRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([runId, createdAt])
}

model FactoryApproval {
  id             String                @id @default(uuid())
  organizationId String
  runId          String
  stage          String // PLAN | PATCH | MERGE | DEPLOY
  status         FactoryApprovalStatus @default(PENDING)
  requestedRole  String?
  requestedById  String?
  decidedById    String?
  reason         String?
  createdAt      DateTime              @default(now())
  decidedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FactoryRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("FactoryApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([runId, stage])
}

model FactoryQualityGate {
  id             String            @id @default(uuid())
  organizationId String
  runId          String
  name           String
  status         FactoryGateStatus @default(PENDING)
  detail         String?
  evidence       Json              @default("{}")
  scanId         String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FactoryRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  scan         DevScan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@unique([runId, name])
  @@index([organizationId, status])
}

/// Observed repetitive work. Proposals are advisory: approving one records the
/// decision and the proposed workflow shape, but nothing is activated without a
/// separate explicit workflow definition.
model AutomationProposal {
  id                    String    @id @default(uuid())
  organizationId        String
  fingerprint           String
  title                 String
  description           String
  category              String
  frequency             Int
  estimatedMinutesSaved Int
  complexity            String
  risk                  String
  requiredPermissions   String[]
  proposedWorkflow      Json      @default("{}")
  evidence              Json      @default("{}")
  status                String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdById           String?
  decidedById           String?
  decisionReason        String?
  createdAt             DateTime  @default(now())
  decidedAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, frequency])
}

/// Pull request metadata attached to a factory run. The branch/commit live on
/// FactoryRun; this row is the review surface (diff stats, checks, findings).
model FactoryPullRequest {
  id               String    @id @default(uuid())
  organizationId   String
  runId            String    @unique
  repositoryId     String
  number           Int
  title            String
  body             String?
  sourceBranch     String
  targetBranch     String
  status           String    @default("OPEN") // OPEN | MERGED | CLOSED
  risk             String?
  changedFiles     Json      @default("[]")
  diffStats        Json      @default("{}")
  commitShas       Json      @default("[]")
  findings         Json      @default("[]")
  securityFindings Json      @default("[]")
  checks           Json      @default("[]")
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  mergedAt         DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          FactoryRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([organizationId, status, createdAt])
  @@index([runId])
}
