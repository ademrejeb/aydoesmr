# ---------------------------------------------------------------------------
# TechVerse — local development environment
# Copy to `.env` for docker compose. Every value below has a safe dev default,
# so `docker compose up -d` works without this file.
# ---------------------------------------------------------------------------

# Postgres (docker compose service; also used by pgAdmin)
POSTGRES_DB=techverse
POSTGRES_USER=techverse
POSTGRES_PASSWORD=techverse_dev

# pgAdmin login (http://localhost:5050)
PGADMIN_EMAIL=admin@techverse.dev
PGADMIN_PASSWORD=admin

# API
DATABASE_URL=postgresql://techverse:techverse_dev@localhost:5432/techverse
# Local-only default. Override with a real secret anywhere this stack is shared.
JWT_SECRET=local-dev-only-8f3c1d7a9b2e4f6a
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
# Development-only key; replace with a unique 64-char hex key anywhere shared.
AI_ENCRYPTION_KEY=9cab9e17ca5788d9e1ddc7623d2fd860c1d910e5dfa05b34ac454d0654dbf030
# Only enable for an Agent Factory on a trusted private network.
AGENT_FACTORY_ALLOW_PRIVATE=false

# Software factory runner.
# Docker gets a networkless, CPU/memory-limited container. Local execution is
# only for trusted development machines and must stay disabled in production.
FACTORY_ALLOW_LOCAL_EXEC=false
FACTORY_RUNNER_IMAGE=node:22-alpine
FACTORY_RUNNER_TIMEOUT_MS=300000
# Per-run AI budget (triage + planning + agent). 0 disables the check.
FACTORY_MAX_AI_TOKENS_PER_RUN=120000
# Optional USD rates used to estimate cost; leave at 0 to record tokens only.
FACTORY_INPUT_COST_PER_1K=0
FACTORY_OUTPUT_COST_PER_1K=0

# Service URLs
PORT=3001
GATEWAY_URL=http://localhost:8081
WS_URL=http://localhost:8092
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# Frontend (techdebt-platform)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:8092


# --- Basacore identity gateway (optional) -----------------------------------
# Create a login client in Basacore Console > Applications > <app> > Sign-in.
BASACORE_ISSUER=http://localhost:8000
# API-side base URL for token/JWKS calls (Docker: http://host.docker.internal:8000)
BASACORE_INTERNAL_ISSUER=http://localhost:8000
BASACORE_CLIENT_ID=
BASACORE_CLIENT_SECRET=
# Must match the redirect registered on the Basacore login client exactly.
BASACORE_REDIRECT_URI=http://localhost:3000/auth/basacore/callback

# Browser-visible values used to start the authorization-code + PKCE flow.
NEXT_PUBLIC_BASACORE_ISSUER=http://localhost:8000
NEXT_PUBLIC_BASACORE_CLIENT_ID=
NEXT_PUBLIC_BASACORE_TENANT_HINT=
